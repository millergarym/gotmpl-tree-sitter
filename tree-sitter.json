{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gotmpl",
      "camelcase": "Gotmpl",
      "scope": "source.gotmpl",
      "path": ".",
      "file-types": ["tmpl", "gotmpl", "gohtml", "tpl"],
      "highlights": ["queries/highlights.scm"],
      "injection-regex": "^(gotmpl|gotemplate|go-template)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Go template language (text/template & html/template)",
    "authors": [
      {
        "name": "Gary Miller",
        "email": "garym@nettex.com.au"
      }
    ],
    "links": {
      "repository": "https://github.com/millergarym/gotmpl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
